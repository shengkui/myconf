// 将键绑定放入此文件中以覆盖默认值
[
    {
        "key": "ctrl+alt+u",
        "command": "editor.action.transformToUppercase"
    },
    {
        "key": "ctrl+alt+l",
        "command": "editor.action.transformToLowercase"
    },
    {
        "key": "ctrl+h n",
        "command": "persistent-highlighter.jumpToNextHighlight"
    },
    {
        "key": "ctrl+h a",
        "command": "persistent-highlighter.addHighlight"
    }
]